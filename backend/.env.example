# Copy this file to backend/.env (which git ignores) and fill in the values.

# Neon: Project dashboard → Connect → copy the connection string, then change
# sslmode=require to sslmode=verify-full (same security pg uses today; avoids a
# warning about require getting weaker in pg v9). It looks like
# postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require
DATABASE_URL=

# Tests: the same string with "-pooler" removed from the host (Neon's direct
# connection). Each test run creates and drops its own schema, so your real data
# isn't touched, but the pooler can't keep a per-connection schema setting.
TEST_DATABASE_URL=

# Port for the API server
PORT=3001

# Where the frontend runs, allowed to call the API from the browser
CORS_ORIGIN=http://localhost:5173
